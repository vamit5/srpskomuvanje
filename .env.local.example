# Kopiraj ovaj fajl u .env.local i popuni vrednosti sa supabase.com/dashboard
# (Project Settings -> API). .env.local se NIKAD ne komituje u git (već je u .gitignore).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service role key -- SAMO za server-side kod (npr. admin panel, webhook-ovi).
# NIKAD ne izlagati klijentu / NIKAD prefiks NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Popunjava se u FAZI 7 (push notifikacije):
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
