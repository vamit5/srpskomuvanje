# Kopiraj ovaj fajl u .env.local i popuni vrednosti sa supabase.com/dashboard
# (Project Settings -> API). .env.local se NIKAD ne komituje u git (već je u .gitignore).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service role key -- SAMO za server-side kod (admin panel, push notifikacije
# za druge korisnike). NIKAD ne izlagati klijentu / NIKAD prefiks NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Push notifikacije -- generiši svoj par sa: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:srpskomuvanje@gmail.com

# Stripe (Premium pretplata) -- koristi TEST ključeve dok se ne lansira uživo.
# Dashboard -> Developers -> API keys (secret key) i Product catalog (price id).
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PREMIUM_PRICE_ID=price_...
# Dashboard -> Developers -> Webhooks (posle deploy-a), ili `stripe listen` lokalno.
STRIPE_WEBHOOK_SECRET=whsec_...

# NSFW moderacija fotografija/videa -- besplatan nalog na sightengine.com
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
